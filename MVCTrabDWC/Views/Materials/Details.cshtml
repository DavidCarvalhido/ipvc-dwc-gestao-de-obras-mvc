@model MVCTrabDWC.Models.Material

@{
    ViewData["Title"] = "Detalhes do Material";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-lg px-4">
    <h1>Detalhes</h1>

    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">@Model.Descricao</dd>

        <dt class="col-sm-3">Stock Disponível</dt>
        <dd class="col-sm-9">@Model.StockDisponivel</dd>
    </dl>

    <a class="btn btn-secondary" asp-action="Index">Voltar</a>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
</div>
