@model MVCTrabDWC.Models.Material

@{
    ViewData["Title"] = "Novo Material";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-lg px-4">
    <h1>Novo Material</h1>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do Material</label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição</label>
            <textarea asp-for="Descricao" class="form-control"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StockDisponivel" class="form-label">Stock Disponível</label>
            <input asp-for="StockDisponivel" class="form-control" />
            <span asp-validation-for="StockDisponivel" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
