@model MVCTrabDWC.Models.Cliente

@{
    ViewData["Title"] = "Remover Cliente";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-lg px-4">
    <h1>Remover Cliente</h1>

    <div class="alert alert-warning">
        Tem a certeza que pretende remover este cliente?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>

        <dt class="col-sm-3">NIF</dt>
        <dd class="col-sm-9">@Model.NIF</dd>

        <dt class="col-sm-3">Morada</dt>
        <dd class="col-sm-9">@Model.Morada</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Remover</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="text-danger mt-3">
            @foreach (var m in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@m.ErrorMessage</div>
            }
        </div>
    }
</div>
