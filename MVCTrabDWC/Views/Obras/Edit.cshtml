@model MVCTrabDWC.Models.Obra

@{
    ViewData["Title"] = "Editar Obra";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-lg px-4">
    <h1>Editar Obra</h1>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="NomeObra" class="form-label"></label>
            <input asp-for="NomeObra" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="DescricaoObra" class="form-label"></label>
            <textarea asp-for="DescricaoObra" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Cliente</label>
            <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.Clientes"></select>
        </div>

        <div class="mb-3">
            <label asp-for="Morada" class="form-label"></label>
            <input asp-for="Morada" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Latitude" class="form-label"></label>
            <input asp-for="Latitude" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Longitude" class="form-label"></label>
            <input asp-for="Longitude" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="Ativa" class="form-check-input" />
            <label asp-for="Ativa" class="form-check-label"></label>
        </div>

        <button class="btn btn-primary">Guardar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
