@model MVCTrabDWC.Models.RegistoMaoObra

<div class="card mb-3">
    <div class="card-header">Registo de Mão de Obra</div>
    <div class="card-body">
        <form asp-controller="RegistosMaoObra" asp-action="Create" method="post" class="row g-3">
            <input type="hidden" name="obraId" value="@Model.ObraId" />

            <div class="col-md-6">
                <label class="form-label">Nome da Pessoa</label>
                <input type="text" name="nomePessoa" class="form-control" required />
            </div>

            <div class="col-md-3">
                <label class="form-label">Horas Trabalhadas</label>
                <input type="number" name="horasTrabalhadas" class="form-control" min="0.1" step="0.1" required />
            </div>

            <div class="col-md-3">
                <label class="form-label">Observações (opcional)</label>
                <input type="text" name="observacoes" class="form-control" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Registar Mão de Obra</button>
            </div>
        </form>
    </div>
</div>
