@model MVCTrabDWC.Models.Obra

@{
    ViewData["Title"] = "Remover Obra";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-lg px-4">
    <h1>Remover Obra</h1>

    <div class="alert alert-warning">
        Tem a certeza que pretende remover esta obra?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Nome da Obra</dt>
        <dd class="col-sm-9">@Model.NomeObra</dd>

        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@Model.Cliente?.Nome</dd>

        <dt class="col-sm-3">Morada</dt>
        <dd class="col-sm-9">@Model.Morada</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger">Remover</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>

