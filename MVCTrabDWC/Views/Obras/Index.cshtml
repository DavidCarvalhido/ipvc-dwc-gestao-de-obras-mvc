@model IEnumerable<MVCTrabDWC.Models.Obra>

@{
    ViewData["Title"] = "Obras";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-lg px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Obras</h1>
        <a class="btn btn-primary" asp-action="Create">Nova Obra</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome da Obra</th>
                <th>Cliente</th>
                <th>Ativa</th>
                <th style="width: 200px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obra in Model)
            {
                <tr>
                    <td>@obra.NomeObra</td>
                    <td>@obra.Cliente?.Nome</td>
                    <td>@(obra.Ativa ? "Sim" : "Não")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@obra.Id">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@obra.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@obra.Id">Remover</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
