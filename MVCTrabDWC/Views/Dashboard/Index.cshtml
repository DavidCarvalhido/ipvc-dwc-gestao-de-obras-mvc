@model MVCTrabDWC.Models.DashboardViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var chartLabels = Model.MateriaisMaisUsados?
        .Select(m => m.Material)
        .ToList() ?? new List<string>();

    var chartData = Model.MateriaisMaisUsados?
        .Select(m => m.Quantidade)
        .ToList() ?? new List<int>();
}

<div class="container-lg px-4">
    <h1 class="mb-4">Resumo Logístico</h1>

    <!-- Clientes -->
    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="fs-4 fw-semibold">@Model.TotalClientes</div>
                    <div>Clientes</div>
                    <svg class="icon position-absolute end-0 bottom-0 me-3 mb-3 opacity-25" width="48" height="48">
                        <use xlink:href="/vendors/icons/free.svg#cil-user"></use>
                    </svg>
                </div>
            </div>
        </div>
        <!-- Obras -->
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="fs-4 fw-semibold">@Model.TotalObras</div>
                    <div>Obras</div>
                    <svg class="icon position-absolute end-0 bottom-0 me-3 mb-3 opacity-25" width="48" height="48">
                        <use xlink:href="/vendors/icons/free.svg#cil-briefcase"></use>
                    </svg>
                </div>
            </div>
        </div>
        <!-- Obras Ativas -->
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="fs-4 fw-semibold">@Model.ObrasAtivas</div>
                    <div>Obras Ativas</div>
                    <svg class="icon position-absolute end-0 bottom-0 me-3 mb-3 opacity-25" width="48" height="48">
                        <use xlink:href="/vendors/icons/free.svg#cil-check-circle"></use>
                    </svg>
                </div>
            </div>
        </div>
        <!-- Stock Baixo -->
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="fs-4 fw-semibold">@Model.MateriaisBaixoStock</div>
                    <div>Stock Baixo</div>
                    <svg class="icon position-absolute end-0 bottom-0 me-3 mb-3 opacity-25" width="48" height="48">
                        <use xlink:href="/vendors/icons/free.svg#cil-warning"></use>
                    </svg>
                </div>
            </div>
        </div>
    </div>
    <!-- Gráfico de barras (Materiais mais utilizados) -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card mb-4">
                <div class="card-header">
                    Materiais mais utilizados
                </div>
                <div class="card-body">
                    <canvas id="materiaisChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos Movimentos -->
    @* <div class="row">
        <div class="col-lg-12">
            <div class="card mb-4">
                <div class="card-header">
                    Últimos Movimentos de Stock
                </div>
                <div class="card-body">
                    @if (!Model.UltimosMovimentos.Any())
                    {
                        <div class="text-muted">Sem movimentos registados.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Obra</th>
                                        <th>Cliente</th>
                                        <th>Operação</th>
                                        <th class="text-end">Quantidade</th>
                                        <th class="text-end">Data</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mov in Model.UltimosMovimentos)
                                    {
                                        <tr>
                                            <td>@mov.Obra</td>
                                            <td>@mov.Cliente</td>
                                            <td>
                                                <span class="badge @(mov.Operacao == "ADD" ? "bg-success" : "bg-danger")">
                                                    @mov.Operacao
                                                </span>
                                            </td>
                                            <td class="text-end">@mov.Quantidade</td>
                                            <td class="text-end">@mov.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div> *@
</div>

@section Scripts {
    <script>
        // Chart.js bar chart
        const ctx = document.getElementById('materiaisChart');

        const labels = @Html.Raw(JsonSerializer.Serialize(chartLabels));
        const data = @Html.Raw(JsonSerializer.Serialize(chartData));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Quantidade utilizada',
                    data: data
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true,
                        position: 'right',
                    }
                }
            }
        });
    </script>
}
