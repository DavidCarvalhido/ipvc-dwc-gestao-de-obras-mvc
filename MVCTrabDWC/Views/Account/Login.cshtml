@model LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <base href="~/">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="CoreUI - Open Source Bootstrap Admin Template">
    <meta name="author" content="Łukasz Holeczek">
    <meta name="keyword" content="Bootstrap,Admin,Template,Open,Source,jQuery,CSS,HTML,RWD,Dashboard">
    <title>Login</title>





    <!-- ver antes disto -->
    <!-- Vendors styles -->
    <link rel="stylesheet" href="~/vendors/simplebar/simplebar.css">
    <link rel="stylesheet" href="~/css/vendors/simplebar.css">
    <!-- Main styles for this application-->
    <link href="~/css/style.css" rel="stylesheet">
    <!-- We use those styles to show code examples, you should remove them in your application.-->
    <link href="~/css/examples.css" rel="stylesheet">
    <script src="~/js/config.js"></script>
    <script src="~/js/color-modes.js"></script>
    <link href="~/vendors/chartjs/css/coreui-chartjs.css" rel="stylesheet">
</head>
<body>
    <div class="bg-body-tertiary min-vh-100 d-flex flex-row align-items-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card-group d-block d-md-flex row">
                        <div class="card col-md-7 p-4 mb-0">
                            <div class="card-body">
                                <h1>Iniciar Sessão</h1>
                                <p class="text-body-secondary">Entrar com a conta de administrador</p>
                                <form asp-action="Login" method="post">
                                    <div class="mb-4">
                                        <div class="input-group mb-1">
                                            <span class="input-group-text">
                                                <svg class="icon">
                                                    <use xlink:href="/vendors/icons/free.svg#cil-user">
                                                    </use>
                                                </svg>
                                            </span>
                                            <input asp-for="Email" class="form-control" placeholder="Email de utilizador" />
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                     </div>
                                    <div class="mb-4">
                                        <div class="input-group mb-1">
                                            <span class="input-group-text">
                                                <svg class="icon">
                                                    <use xlink:href="/vendors/icons/free.svg#cil-lock-locked">
                                                    </use>
                                                </svg>
                                            </span>
                                            <input asp-for="Password" class="form-control" placeholder="Palavra-passe" />
                                        
                                        </div>
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <button class="btn btn-primary px-4" type="submit">Entrar</button>
                                        </div>
                                        <div class="col-6 text-end">
                                            <input asp-for="RememberMe" class="form-check-input" />
                                            <label asp-for="RememberMe" class="form-check-label">Lembrar-me</label>
                                        </div>
                                    </div>
                                </form>
                                @* @if (!ViewData.ModelState.IsValid)
                                {
                                    <div class="text-danger mt-2">
                                        @Html.ValidationSummary()
                                    </div>
                                } *@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
